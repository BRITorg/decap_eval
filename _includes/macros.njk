{% macro button(label, url, variant="accent", size="md") %}
{%- set bg = "var(--color-accent)" -%}
{%- set fg = "var(--color-white)" -%}
{%- set border = "none" -%}
{%- if variant == "subtle-outline" -%}
  {%- set bg = "transparent" -%}
  {%- set fg = "var(--text-heading)" -%}
  {%- set border = "1px solid var(--border-strong)" -%}
{%- endif -%}
{%- set padY = "var(--btn-padding-y)" -%}
{%- set padX = "var(--btn-padding-x)" -%}
{%- set fontSize = "var(--text-sm)" -%}
{%- if size == "sm" -%}
  {%- set padY = "var(--space-xxs)" -%}
  {%- set padX = "var(--space-sm)" -%}
  {%- set fontSize = "var(--text-xs)" -%}
{%- endif -%}
<a href="{{ url | url }}" style="display:inline-flex;align-items:center;gap:var(--space-xxs);font-family:var(--font-primary);font-weight:700;font-size:{{ fontSize }};text-decoration:none;border-radius:var(--btn-radius);padding:{{ padY }} {{ padX }};background:{{ bg }};color:{{ fg }};border:{{ border }};transition:all var(--duration-fast) var(--ease-out);">{{ label }}</a>
{% endmacro %}

{% macro badge(label) %}
<span style="display:inline-block;font-family:var(--font-primary);font-size:var(--text-xs);font-weight:700;color:var(--color-contrast-higher);background:var(--color-tertiary);padding:var(--space-xxxs) var(--space-xs);border-radius:var(--radius-full);">{{ label }}</span>
{% endmacro %}

{% macro sectionHeading(eyebrow, title, standfirst="", level="h1") %}
{% if eyebrow %}<div style="font-family:var(--font-primary);font-size:var(--text-xs);font-weight:700;text-transform:uppercase;letter-spacing:var(--eyebrow-letter-spacing);color:var(--color-secondary-dark);margin-bottom:var(--space-xxxs);">{{ eyebrow }}</div>{% endif %}
<{{ level }} style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-xxl);color:var(--text-heading);margin:0 0 var(--space-xs);">{{ title }}</{{ level }}>
{% if standfirst %}<p style="font-family:var(--font-primary);font-size:var(--text-md);line-height:var(--body-line-height);color:var(--text-muted);margin:0 0 var(--space-sm);max-width:60ch;">{{ standfirst }}</p>{% endif %}
{% endmacro %}
