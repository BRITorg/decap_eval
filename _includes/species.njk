---
layout: base.njk
---
{% import "macros.njk" as m %}
<section style="background:var(--surface-page);">
  <div style="max-width:var(--max-width-sm);margin:0 auto;padding:var(--space-xl) var(--component-padding);">
    <a href="{{ '/species/' | url }}" style="font-family:var(--font-primary);font-size:var(--text-sm);text-decoration:none;">← Species Index</a>
    <div style="display:flex;gap:var(--space-lg);flex-wrap:wrap;align-items:flex-start;margin-top:var(--space-sm);">
      <div class="placeholder-box" style="width:280px;height:320px;flex-shrink:0;">Species photo or illustration</div>
      <div style="flex:1;min-width:260px;">
        <div style="font-family:var(--font-primary);font-size:var(--text-xs);font-weight:700;text-transform:uppercase;letter-spacing:var(--eyebrow-letter-spacing);color:var(--color-secondary-dark);margin-bottom:var(--space-xxxs);">{{ family }}</div>
        <h1 style="font-family:var(--font-primary);font-style:italic;font-weight:700;font-size:var(--text-xxl);color:var(--text-heading);margin:0;">{{ title }}</h1>
        {% if author_citation %}<div style="font-family:var(--font-primary);font-size:var(--text-sm);color:var(--text-muted);margin:var(--space-xxxs) 0 var(--space-sm);">{{ author_citation }}</div>{% endif %}
        <div style="display:flex;gap:var(--space-xxs);flex-wrap:wrap;">
          {% for name in common_names.split(",") %}{{ m.badge(name.trim()) }}{% endfor %}
        </div>
      </div>
    </div>

    <div style="margin-top:var(--space-xl);">
      <h2 style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-xl);color:var(--text-heading);margin:0 0 var(--space-xs);">Description</h2>
      {{ content | safe }}
    </div>

    <div style="margin-top:var(--space-lg);">
      <h2 style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-xl);color:var(--text-heading);margin:0 0 var(--space-xs);">Distribution in Texas</h2>
      <div class="placeholder-box" style="width:100%;max-width:500px;height:280px;">County distribution map</div>
    </div>

    {% if habitat %}
    <div style="margin-top:var(--space-lg);">
      <h2 style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-xl);color:var(--text-heading);margin:0 0 var(--space-xs);">Habitat</h2>
      <p style="font-family:var(--font-primary);font-size:var(--text-md);line-height:var(--body-line-height);color:var(--text-muted);font-style:italic;margin:0;">{{ habitat }}</p>
    </div>
    {% endif %}
  </div>
</section>
