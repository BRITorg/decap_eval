{% import "macros.njk" as m %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | Ferns of Texas</title>
  <link rel="stylesheet" href="{{ '/assets/tokens/colors.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/tokens/typography.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/tokens/spacing.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/tokens/shape.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/tokens/fonts.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/tokens/base.css' | url }}">
  <style>
    .placeholder-box { display:flex; align-items:center; justify-content:center; text-align:center; background:var(--surface-sunken); color:var(--text-muted); font-family:var(--font-primary); font-size:var(--text-xs); border-radius:var(--radius-xl); }
    .tile { display:block; padding:var(--space-sm); background:var(--surface-card); border-radius:var(--radius-xl); box-shadow:var(--shadow-xs); text-decoration:none; color:inherit; }
    .tile-eyebrow { font-family:var(--font-primary); font-size:var(--text-xs); font-weight:700; text-transform:uppercase; letter-spacing:var(--eyebrow-letter-spacing); color:var(--color-secondary-dark); margin-bottom:var(--space-xxxs); }
  </style>
</head>
<body>
{% include "header.njk" %}

{% if raw or family %}

{{ content | safe }}

{% elif authors %}

<section style="background:var(--surface-page);">
  <div style="max-width:var(--max-width-sm);margin:0 auto;padding:var(--space-xl) var(--component-padding);">
    {{ m.sectionHeading("About", title) }}
    {% for author in authors %}
    <div style="display:flex;gap:var(--space-sm);flex-wrap:wrap;align-items:flex-start;margin-top:var(--space-md);">
      <div class="placeholder-box" style="width:120px;height:120px;flex-shrink:0;border-radius:50%;">Photo</div>
      <div style="flex:1;min-width:240px;">
        <h2 style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-lg);color:var(--text-heading);margin:0 0 var(--space-xxs);">{{ author.name }}</h2>
        <p style="font-family:var(--font-primary);font-size:var(--text-md);line-height:var(--body-line-height);color:var(--text-muted);margin:0;font-style:italic;">{{ author.bio }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{% elif terms %}

<section style="background:var(--surface-page);">
  <div style="max-width:var(--max-width-sm);margin:0 auto;padding:var(--space-xl) var(--component-padding);">
    {{ m.sectionHeading("Reference", title, standfirst) }}
    <div style="margin-top:var(--space-md);">
      {% for term in terms %}
      <details {% if loop.first %}open{% endif %} style="border-bottom:1px solid var(--border-subtle);padding:var(--space-xs) 0;">
        <summary style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-md);color:var(--text-heading);cursor:pointer;">{{ term.title }}</summary>
        <p style="font-family:var(--font-primary);font-size:var(--text-md);line-height:var(--body-line-height);color:var(--text-muted);margin:var(--space-xxs) 0 0;">{{ term.body }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

{% elif page.fileSlug == "home" %}

<section style="background:var(--surface-card);">
  <div style="max-width:var(--max-width-xxl);margin:0 auto;padding:var(--space-xl) var(--component-padding);display:flex;gap:var(--space-xl);flex-wrap:wrap;align-items:center;">
    <div class="placeholder-box" style="width:280px;height:360px;flex-shrink:0;">Book cover — The Ferns and Lycophytes of Texas</div>
    <div style="flex:1;min-width:280px;">
      {{ m.sectionHeading(eyebrow, title) }}
      {{ content | safe }}
      <div style="display:flex;gap:var(--space-xs);flex-wrap:wrap;margin-top:var(--space-sm);">
        {{ m.button("Browse the Species Index", "/species/", "accent") }}
        {{ m.button("Try the Visual Key", "/visual-key/", "subtle-outline") }}
      </div>
    </div>
  </div>
</section>

<section style="background:var(--surface-page);">
  <div style="max-width:var(--max-width-xxl);margin:0 auto;padding:var(--space-lg) var(--component-padding);">
    {{ m.sectionHeading("Explore", "Explore the Site", "", "h2") }}
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:var(--space-sm);margin-top:var(--space-sm);">
      <a href="{{ '/species/' | url }}" class="tile"><div class="tile-eyebrow">Browse</div><div style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-lg);color:var(--text-heading);margin-bottom:var(--space-xxxs);">Species Index</div><div style="font-family:var(--font-primary);font-size:var(--text-sm);color:var(--text-muted);">Every fern and lycophyte documented in the book.</div></a>
      <a href="{{ '/visual-key/' | url }}" class="tile"><div class="tile-eyebrow">Identify</div><div style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-lg);color:var(--text-heading);margin-bottom:var(--space-xxxs);">Visual Key</div><div style="font-family:var(--font-primary);font-size:var(--text-sm);color:var(--text-muted);">An interactive key to identifying Texas ferns and lycophytes.</div></a>
      <a href="{{ '/glossary/' | url }}" class="tile"><div class="tile-eyebrow">Reference</div><div style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-lg);color:var(--text-heading);margin-bottom:var(--space-xxxs);">Glossary</div><div style="font-family:var(--font-primary);font-size:var(--text-sm);color:var(--text-muted);">Definitions for the botanical terms used in the book and site.</div></a>
      <a href="{{ '/literature-cited/' | url }}" class="tile"><div class="tile-eyebrow">Reference</div><div style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-lg);color:var(--text-heading);margin-bottom:var(--space-xxxs);">Literature Cited</div><div style="font-family:var(--font-primary);font-size:var(--text-sm);color:var(--text-muted);">Sources referenced in the preparation of the book.</div></a>
    </div>
  </div>
</section>

{% elif page.fileSlug == "buy-the-book" %}

<section style="background:var(--surface-page);">
  <div style="max-width:var(--max-width-sm);margin:0 auto;padding:var(--space-xl) var(--component-padding);">
    {{ m.sectionHeading(eyebrow, title) }}
    <div style="display:flex;gap:var(--space-lg);flex-wrap:wrap;align-items:flex-start;margin-top:var(--space-md);">
      <div class="placeholder-box" style="width:220px;height:290px;flex-shrink:0;">Book cover</div>
      <div style="flex:1;min-width:260px;">
        <h2 style="font-family:var(--font-primary);font-weight:700;font-size:var(--text-lg);color:var(--text-heading);margin:0 0 var(--space-xxs);">{{ book_title }}</h2>
        <p style="font-family:var(--font-primary);font-size:var(--text-md);color:var(--text-muted);margin:0 0 var(--space-sm);">{{ byline }}</p>
        {% if cta_url %}{{ m.button(cta_label, cta_url, "accent") }}{% endif %}
      </div>
    </div>
  </div>
</section>

{% else %}

<section style="background:var(--surface-page);">
  <div style="max-width:var(--max-width-sm);margin:0 auto;padding:var(--space-xl) var(--component-padding);">
    {{ m.sectionHeading(eyebrow, title, standfirst) }}
    {{ content | safe }}
    {% if cta_url %}<div style="margin-top:var(--space-sm);">{{ m.button(cta_label, cta_url, "accent") }}</div>{% endif %}
  </div>
</section>

{% endif %}

{% include "footer.njk" %}
</body>
</html>
